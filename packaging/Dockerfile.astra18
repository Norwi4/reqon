ARG ASTRA_IMAGE=registry.astralinux.ru/library/astra/ubi18:1.8
FROM ${ASTRA_IMAGE}
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-pip libpython3.11 binutils dpkg-dev xz-utils ca-certificates curl \
    xvfb xauth openbox wmctrl fonts-dejavu-core \
    libgl1 libegl1 libopengl0 libglib2.0-0 libdbus-1-3 libfontconfig1 libfreetype6 \
    libx11-6 libx11-xcb1 libxext6 libxrender1 libsm6 libice6 \
    libxkbcommon0 libxkbcommon-x11-0 libxcb1 libxcb-shape0 libxcb-cursor0 libxcb-icccm4 \
    libxcb-image0 libxcb-keysyms1 libxcb-render-util0 libxcb-xinerama0 libxcb-xkb1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY requirements.txt .
RUN python3 -m venv /opt/reqon-build-env && /opt/reqon-build-env/bin/pip install -r requirements.txt
COPY . .
RUN mkdir -p build/linux && ln -s /opt/reqon-build-env build/linux/venv
CMD ["bash", "packaging/verify-astra-build.sh"]
