# Used by Docker Compose. For a direct Node launch, use --env-file=.env.
DOMAIN=reqon.ru
GITHUB_REPO=Norwi4/reqon
RELEASE_SOURCE=github
# Relative to website/ when using Compose, or an absolute path on your VDS.
RELEASES_HOST_DIR=../dist
# Optional for the public repository; do not commit real credentials.
GITHUB_TOKEN=
# Direct Node launch only; Compose sets SITE_URL from DOMAIN.
# SITE_URL=https://reqon.ru
# RELEASES_DIR=../dist
# HOST=127.0.0.1
# PORT=4173
