# Publish source, required runtime assets, packaging and user documentation.
# New top-level folders are local unless explicitly included below.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/Cargo.toml
!/Cargo.lock
!/cargo-local.ps1
!/start.cmd
!/README.md
!/THIRD_PARTY_NOTICES.md
!/src/
!/vendor/
!/assets/
!/scripts/
!/packaging/
!/docs/

# Standalone tests and local QA stay on disk, outside the source repository.
/tests/
/src/*_tests.rs
/vendor/*/tests/
/vendor/*/benches/
/assets/licenses/**/src/tests/
/.github/
/.qa/
/test-results/
/target/
/dist/
/data/
/.cargo-home/

# Keep patched dependencies, including their licenses and patch notes.
/vendor/*/*
!/vendor/*/src/
!/vendor/*/Cargo.toml
!/vendor/*/README.md
!/vendor/*/REQON-PATCH.md
!/vendor/*/LICENSE*

# Only assets used by the application or distribution are published.
/assets/*
!/assets/icons/
!/assets/fonts/
!/assets/runtime/
!/assets/themes/
!/assets/licenses/
!/assets/BRUNO-LICENSE.txt
!/assets/pac.js
!/assets/brand/
/assets/brand/*
!/assets/brand/circular-v1/
/assets/brand/circular-v1/*
!/assets/brand/circular-v1/png/
!/assets/brand/circular-v1/svg/
!/assets/brand/circular-v1/windows/

# Build, packaging, publishing and runtime conversion helpers.
/scripts/*
!/scripts/build-installer.ps1
!/scripts/build-linux.ps1
!/scripts/package.ps1
!/scripts/package-cli.ps1
!/scripts/package-linux.sh
!/scripts/embed-windows-icon.ps1
!/scripts/embed-windows-version.ps1
!/scripts/embed-windows-manifest.ps1
!/scripts/publish-release.mjs
!/scripts/getman-bridge.py
!/scripts/collect_notices.py
!/scripts/complete_notices.py
!/scripts/generate-brand.py
!/scripts/desktop-shortcut.ps1
/packaging/Dockerfile.linux-smoke

# Product documentation; exclude QA reports, screenshots and internal plans.
/docs/*
!/docs/cli-runner.md
!/docs/dependencies.json
!/docs/environments.md
!/docs/linux.md
!/docs/release-*.md
!/docs/upgrade-*.md
/docs/release-0.20.*.md
/docs/release-0.21.0.md

# Generated media, archives, executables, caches and local credentials.
screenshots/
snapshots/
preview/
__pycache__/
node_modules/
*.py[cod]
*.log
*.zip
*.tar
*.tar.gz
*.7z
*.rar
*.deb
*.rpm
*.exe
*.dll
*.msi
*.pdb
*.bundle
*.tmp
*.bak
.DS_Store
Thumbs.db
.env
.env.*
*.key
*.pem
*.p12
*.pfx
